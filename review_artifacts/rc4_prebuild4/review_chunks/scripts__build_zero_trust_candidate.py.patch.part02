+def read_identity(root: Path = ROOT) -> dict[str, str]:
+    root = root.resolve()
+    code = (
+        "import json; from app.config import settings; "
+        "print(json.dumps({'app':str(settings.app_name),'version':str(settings.app_version),'build_id':str(settings.build_id)}))"
