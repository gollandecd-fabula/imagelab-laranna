+    runtime_dir = args.l3_runtime.resolve()
+    assert_source_test_runtime_capability(extra_runtime=runtime_dir)
+
+    # Build authorization is produced internally. An external PASS JSON is never
+    # accepted as proof that pytest ran. The exact source that passes the gate is
+    # copied to a private snapshot and all build reads use that same snapshot.
+    with tempfile.TemporaryDirectory(prefix="imagelab-build-snapshot-") as tmp:
+        temp_root = Path(tmp)
+        build_root = temp_root / "source"
+        copy_source_snapshot(ROOT, build_root)
+        source_gate_receipt = temp_root / "source-gate-receipt.json"
+        gate = run_full_source_gate(root=build_root, runtime_dir=runtime_dir, receipt_path=source_gate_receipt)
+        approved_source_tree = dict(gate["source_tree"])
+        approved_runtime_tree = dict(gate["runtime_tree"])
+
