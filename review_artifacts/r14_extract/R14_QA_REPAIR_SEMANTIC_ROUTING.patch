+def _working_fragment_diagnostics(asset: AssetRecord) -> dict[str, Any] | None:
+    """Return the manual R14 working-fragment contract, if explicitly recorded.
+
+    Do not infer this semantic from opacity or ROI parameters alone. The producer
+    must explicitly record `semantics=working_fragment`; otherwise legacy cutout
+    QA remains authoritative.
+    """
+    if asset.operation != "extract_print" or not isinstance(asset.parameters, dict):
+        return None
+    diagnostics = asset.parameters.get("diagnostics")
+    if not isinstance(diagnostics, dict):
+        return None
+    fidelity = diagnostics.get("extract_fidelity")
+    manual = diagnostics.get("manual_roi_working_fragment")
+    candidates = [item for item in (fidelity, manual) if isinstance(item, dict)]
+    if not any(str(item.get("semantics", "")).strip().lower() == "working_fragment" for item in candidates):
+        return None
+    merged: dict[str, Any] = {}
+    for item in candidates:
+        merged.update(item)
+    return merged
+
+
 
