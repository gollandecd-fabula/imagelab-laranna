+def _post_resize_smoothing(image: Image.Image, strength: int, *, upscale_factor: float = 1.0) -> Image.Image:
+    """Scale-aware anti-pixel smoothing applied after the final resize.
+
+    Processing is tiled so large print images do not allocate multiple full-size
+    float32 working planes. Strength 0 is a strict no-op.
+    """
+    value = int(np.clip(int(strength), 0, 100))
+    if value <= 0:
+        return image
