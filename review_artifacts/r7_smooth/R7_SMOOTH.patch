+    out = source.copy()
+    t = value / 100.0
+    scale = float(np.clip(upscale_factor, 1.0, 10.0))
+    sigma = 0.28 + t * (0.72 + 0.18 * scale)
+    base_weight = float(np.clip(0.08 + 0.62 * t, 0.08, 0.70))
+    tile_size = 1024
+
+    # Pass 1: global gradient histogram from tile cores. This keeps one edge
+    # reference for the whole image (no tile seams) without a full float plane.
+    hist = np.zeros(1444, dtype=np.int64)
+    total = 0
+    for y0 in range(0, source.height, tile_size):
+        y1 = min(source.height, y0 + tile_size)
+        for x0 in range(0, source.width, tile_size):
+            x1 = min(source.width, x0 + tile_size)
+            hx0, hy0 = max(0, x0 - 1), max(0, y0 - 1)
+            hx1, hy1 = min(source.width, x1 + 1), min(source.height, y1 + 1)
+            rgb = np.asarray(source.crop((hx0, hy0, hx1, hy1)).convert("RGB"), dtype=np.uint8)
+            gray = cv2.cvtColor(rgb, cv2.COLOR_RGB2GRAY).astype(np.float32)
+            gx = cv2.Sobel(gray, cv2.CV_32F, 1, 0, ksize=3)
+            gy = cv2.Sobel(gray, cv2.CV_32F, 0, 1, ksize=3)
+            mag = cv2.magnitude(gx, gy)
+            core = mag[y0 - hy0:y1 - hy0, x0 - hx0:x1 - hx0]
+            bins = np.minimum(np.rint(core).astype(np.int32), 1443)
+            hist += np.bincount(bins.ravel(), minlength=1444)
+            total += core.size
+    target = max(1, int(math.ceil(total * 0.88)))
+    reference = max(6.0, float(np.searchsorted(np.cumsum(hist), target)))
+
+    # Pass 2: smooth with enough overlap for the Gaussian kernel, then paste
+    # only each tile core. Identical global reference prevents visible seams.
+    halo = max(2, int(math.ceil(4.0 * sigma)) + 1)
+    for y0 in range(0, source.height, tile_size):
+        y1 = min(source.height, y0 + tile_size)
+        for x0 in range(0, source.width, tile_size):
+            x1 = min(source.width, x0 + tile_size)
+            hx0, hy0 = max(0, x0 - halo), max(0, y0 - halo)
+            hx1, hy1 = min(source.width, x1 + halo), min(source.height, y1 + halo)
+            rgba = np.asarray(source.crop((hx0, hy0, hx1, hy1)), dtype=np.uint8)
+            rgb = rgba[:, :, :3]
+            soft = cv2.GaussianBlur(rgb, (0, 0), sigmaX=sigma, sigmaY=sigma, borderType=cv2.BORDER_REPLICATE)
+            gray = cv2.cvtColor(rgb, cv2.COLOR_RGB2GRAY).astype(np.float32)
+            gx = cv2.Sobel(gray, cv2.CV_32F, 1, 0, ksize=3)
+            gy = cv2.Sobel(gray, cv2.CV_32F, 0, 1, ksize=3)
