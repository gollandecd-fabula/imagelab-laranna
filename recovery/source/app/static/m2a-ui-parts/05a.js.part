presetModules=['improve','extract','selection','background','cleanup','color','palette','halftone','vector','geometry','dtf','masters','logo','export','cardlab'];
  function collectParams(module){if(module==='geometry')return geometryParams();if(module==='background')return {feather:number('#m2aBackgroundFeather',2),background_color:$('#m2aBackgroundColor').value};if(module==='color')return {brightness:number('#m2aBrightness',100)/100,contrast:number('#m2aContrast',100)/100,saturation:number('#m2aSaturation',100)/100,temperature:number('#m2aTemperature')};return {};}
  function renderPresets(){const root=$('#m2aPresetList');if(!root)return;root.replaceChildren();const p=state.project?.workspace?.presets||{};Object.entries(p).forEach(([name,x])=>{const row=document.createElement('div');row.className='m2a-preset-row';row.innerHTML=`<div><strong>${escapeHtml(name)}</strong><span>${escapeHtml(x.module)}</span></div><button data-use>Применить</button><button data-delete>Удалить</button>`;row.querySelector('[data-use]').onclick=()=>{activateModule(x.module);toast(`Профиль «${name}» выбран`);};row.querySelector('[data-delete]').onclick=()=>deletePreset(name);root.append(row);});}
  async function savePreset(){const name=$('#m2aPresetName').value.trim(),module=$('#m2aPresetModule').value;if(!name)return toast('Введите название профиля',true);try{state.project=await api(`/api/projects/${encodeURIComponent(PROJECT_ID)}/presets`,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({name,module,parameters:collectParams(module)})});renderProject();renderPresets();toast('Профиль сохранён');}catch(e){toast(e.message,true);}}
  async function deletePreset(name){try{state.project=await api(`/api/projects/${encodeURIComponent(PROJECT_ID)}/presets/${encodeURIComponent(name)}`,{method:'DELETE'});renderProject();renderPresets();}catch(e){toast(e.message,true);}}
  function renderBatch(){const root=$('#m2aBatchAssets');if(!root)return;root.replaceChildren();(state.project?.assets||[]).forEach(a=>{const l=document.createElement('label');l.className='m2a-batch-item';l.innerHTML=`<input type="checkbox" value="${a.id}"><img src="${a.preview_url}" alt=""><span><strong>${escapeHtml(a.original_name)}</strong><small>${a.operation||'original'}</small></span>`;root.append(l);});}
  async function runBatch(){const ids=[...document.querySelectorAll('#m2aBatchAssets input:checked')].map(x=>x.value);if(!ids.length)return toast('Выберите файлы',true);const op=$('#m2aBatchOperation').value,job=$('#m2aBatchJob');job.querySelector('span').textContent='Выполняется…';job.querySelector('progress').value=25;setBusy(true);try{const r=await api(`/api/projects/${encodeURIComponent(PROJECT_ID)}/batch-process`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({asset_ids:ids,operation:op,parameters:{auto_repair:false}})});state.project=r.project;state.selectedId=r.results?.at(-1)?.id||state.selectedId;renderProject();job.querySelector('span').textContent='Готово';job.querySelector('progress').value=100;toast('Пакет завершён');}catch(e){job.querySelector('span').textContent='Ошибка';toast(e.message,true);}finally{setBusy(false);}}

