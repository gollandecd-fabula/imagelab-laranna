  function renderPreview(){document.querySelectorAll('[data-preview-mode]').forEach(b=>b.classList.toggle('active',b.dataset.previewMode===S.mode)); const stage=$('#previewStage'), asset=selectedAsset(); if(!asset)return; const source=(state.project?.assets||[]).find(a=>a.id===asset.source_asset_id)||(state.project?.assets||[])[0]; stage.className=`preview-stage checkerboard m2a-${S.mode}`; stage.replaceChildren(); const wrap=document.createElement('div'); wrap.className='preview-image-wrap m2a-transform-wrap'; const img=(a,c)=>{const n=document.createElement('img');n.src=a.preview_url;n.alt=a.original_name;n.className=c;return n;}; if(S.mode==='original')wrap.append(img(source||asset,'m2a-source-image')); else if(['split','overlay','difference'].includes(S.mode)){wrap.classList.add('m2a-compare');wrap.append(img(source||asset,'m2a-source-image'),img(asset,'m2a-result-image'));if(S.mode==='split'){const r=document.createElement('input');r.type='range';r.min=0;r.max=100;r.value=50;r.className='m2a-split-slider';r.oninput=()=>wrap.style.setProperty('--split',`${r.value}%`);wrap.append(r);}} else wrap.append(img(asset,S.mode==='mask'?'m2a-mask-image':'m2a-result-image')); stage.append(wrap); applyPreviewBackground(); setZoom(S.zoom);}

  async function loadProjects(){try{S.projects=await api('/api/projects');renderProjects();}catch(e){toast(e.message,true);}}
  function renderProjects(){const root=$('#m2aProjectList');if(!root)return;root.replaceChildren();$('#m2aCurrentProject').textContent=state.project?`${state.project.title} · ${state.project.id}`:'Проект не открыт';(S.projects||[]).forEach(p=>{const b=document.createElement('button');b.className=`m2a-project-row${p.id===activeProjectId?' active':''}`;b.innerHTML=`<strong>${escapeHtml(p.title)}</strong><span>${escapeHtml(p.id)} · ${p.assets?.length||0} файлов</span>`;b.onclick=()=>openProject(p.id);root.append(b);});}
  async function openProject(id){
    const previousId=activeProjectId;
    try{
      if(typeof S.prepareProjectSwitch==='function')await S.prepareProjectSwitch();
    }catch(e){
      toast(e.message,true);
      return false;
    }
    const rollbackProject=state.project,rollbackSelected=state.selectedId;
    activeProjectId=id;
    let project;
    try{
      project=await api(`/api/projects/${encodeURIComponent(PROJECT_ID)}`);
      if(!project||project.id!==id)throw new Error('Сервер вернул другой проект; переключение отменено');
    }catch(e){
      activeProjectId=previousId;
      state.project=rollbackProject;
      state.selectedId=rollbackSelected;
      renderProject();
      toast(e.message,true);
      return false;
    }
    state.project=project;
    const pinned=project.workspace?.active_asset_id;
    state.selectedId=project.assets?.some(asset=>asset.id===pinned)?pinned:(project.assets?.at(-1)?.id||null);
    storage.set('imagelab.activeProjectId',id);
    S.projectGeneration=(S.projectGeneration||0)+1;
    renderProject();
    await loadProjects();
    activateModule('upload');
    return true;
  }
  S.openProject=openProject;
  S.resetActiveProjectRoute=()=>{activeProjectId=PROJECT_ID;};
  async function createProject(){const title=$('#m2aProjectTitle').value.trim();if(!title)return toast('Введите название проекта',true);const id=$('#m2aProjectId').value.trim()||`${title.toLowerCase().replace(/[^a-zа-я0-9_-]+/gi,'-').replace(/^-|-$/g,'')||'project'}-${Date.now().toString(36)}`;setBusy(true);try{await api(`/api/projects/${encodeURIComponent(id)}`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({title})});const opened=await openProject(id);if(opened!==false)toast('Проект создан');}catch(e){toast(e.message,true);}finally{setBusy(false);}}
  async function renameProject(){if(!state.project)return toast('Проект не открыт',true);const title=prompt('Новое название проекта',state.project.title);if(title===null)return;try{state.project=await api(`/api/projects/${encodeURIComponent(PROJECT_ID)}/title`,{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({title})});renderProject();await loadProjects();toast('Проект переименован');}catch(e){toast(e.message,true);}}
  function moveHistory(delta){const a=state.project?.assets||[],i=a.findIndex(x=>x.id===state.selectedId),next=a[Math.max(0,i)+delta];if(next)pinActiveAsset(next.id);}

  const 