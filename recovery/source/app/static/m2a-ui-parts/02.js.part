}<div class="row-actions"><button class="secondary-button" id="m2aBatchAll">Выбрать все</button><button class="secondary-button" id="m2aBatchNone">Снять выбор</button></div><div id="m2aBatchAssets" class="m2a-check-list"></div><label>Операция<select id="m2aBatchOperation"><option value="enhance">Улучшение</option><option value="reconstruct">Восстановление</option><option value="background">Удаление фона</option><option value="cleanup">Очистка</option><option value="color">Цвет</option><option value="geometry">Размер</option><option value="halftone">Полутон</option><option value="vectorize">Вектор</option></select></label><button class="primary-button wide" id="m2aRunBatch">Запустить пакет</button><div id="m2aBatchJob" class="m2a-job"><span>Ожидание</span><progress max="100" value="0"></progress></div>`);
    addPane('background', `${card('Отдельный модуль фона','Удаление фона не смешивается с извлечением принта')}<label class="check-row"><input id="m2aBackgroundAi" type="checkbox" checked> AI-маска и preflight</label><label>Цвет замены<input id="m2aBackgroundColor" type="color" value="#ffffff"></label><label class="range-row"><span>Мягкость, px</span><input id="m2aBackgroundFeather" type="range" min="0" max="40" value="2"><output>2 px</output></label><button class="primary-button wide" id="m2aApplyBackground">Применить фон</button>`);
    addPane('color', `${card('Цветокоррекция','Параметры не меняются без запуска')}<label class="range-row"><span>Яркость</span><input id="m2aBrightness" type="range" min="20" max="250" value="100"><output>100%</output></label><label class="range-row"><span>Контраст</span><input id="m2aContrast" type="range" min="20" max="250" value="100"><output>100%</output></label><label class="range-row"><span>Насыщенность</span><input id="m2aSaturation" type="range" min="0" max="300" value="100"><output>100%</output></label><label class="range-row"><span>Температура</span><input id="m2aTemperature" type="range" min="-100" max="100" value="0"><output>0</output></label><button class="primary-button wide" id="m2aApplyColor">Применить цвет</button>`);
    addPane('palette', `${card('Палитра','Анализ и фиксация цветов')}<label>Количество цветов<input id="m2aPaletteCount" type="number" min="2" max="24" value="8"></label><button class="secondary-button wide" id="m2aAnalyzePalette">Проанализировать</button><div id="m2aPaletteSwatches" class="m2a-swatches"></div><button class="primary-button wide" id="m2aLockPalette">Зафиксировать палитру</button>`);
    addPane('dtf', `${card('DTF Preflight','Production-ready только после QA PASS')}<div id="m2aDtfStatus" class="m2a-status blocked"><strong>BLOCKED</strong><span>Запустите DTF-проверку</span></div><label class="check-row"><input id="m2aDtfBinary" type="checkbox" checked> Бинарный Alpha 0/255</label><label>PPI<input id="m2aDtfPpi" type="number" min="100" max="1000" value="300"></label><button class="secondary-button wide" id="m2aDtfQa">Запустить DTF Preflight</button><button class="primary-button wide" id="m2aDtfMaster">Создать DTF Master</button>`);
    addPane('masters', `${card('Производственные мастера','Каждый мастер создаёт отдельную версию')}<button class="secondary-button wide" id="m2aCleanMaster">Clean Master</button><label>Card ширина, мм<input id="m2aCardWidth" type="number" value="300"></label><label>Card высота, мм<input id="m2aCardHeight" type="number" value="400"></label><button class="secondary-button wide" id="m2aCardMaster">Card Master</button><button class="secondary-button wide" id="m2aMasterDtf">DTF Master</button>`);
    addPane('logo', `${card('Подготовка логотипа','Original, Black или Gray')}<div class="segmented"><button class="segment active" data-logo-mode="original">Original</button><button class="segment" data-logo-mode="black">Black</button><button class="segment" data-logo-mode="gray">Gray</button></div><label class="check-row"><input id="m2aLogoRemoveBg" type="checkbox" checked> Удалить фон</label><label class="check-row"><input id="m2aLogoBinary" type="checkbox"> Бинарный Alpha</label><button class="primary-button wide" id="m2aPrepareLogo">Подготовить логотип</button>`);
    addPane('cardlab', `${card('CardLab handoff','Передаётся только выбранная проверенная версия')}<strong id="m2aCardLabAsset">Файл не выбран</strong><a class="primary-button wide link-button" id="m2aCardLabLink" href="#" aria-disabled="true">Создать пакет CardLab</a>`);
    addPane('settings', `${card('Настройки и диагностика','Локальная обработка включена по умолчанию')}<label>Режим<select id="m2aDefaultMode"><option value="professional">Профессионально</option><option value="fast">Быстро</option><option value="autoparams">Автопараметры AI</option><option value="check-only">Только проверка</option></select></label><label>PPI по умолчанию<input id="m2aDefaultPpi" type="number" min="100" max="1000" value="300"></label><label>Фон preview<select id="m2aDefaultPreview"><option value="transparent">Прозрачный</option><option value="white">Белый</option><option value="black">Чёрный</option><option value="gray">Серый</option></select></label><button class="primary-button wide" id="m2aSaveSettings">Сохранить настройки</button><div class="divider"></div><div id="m2aDiagnostics" class="m2a-diagnostics"></div><div id="m2aModelList" class="m2a-list"></div><button class="secondary-button wide" id="m2aRefreshDiagnostics">Обновить диагностику</button>`);
  }

