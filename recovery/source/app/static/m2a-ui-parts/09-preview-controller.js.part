(() => {
  'use strict';

  const M = window.imagelabM2A || (window.imagelabM2A = {});
  const byId = id => document.getElementById(id);
  const clamp = (value, min, max) => Math.min(max, Math.max(min, value));
  const assetDimensions = asset => ({width: Math.max(1, Number(asset?.width_px || 1000)), height: Math.max(1, Number(asset?.height_px || 1000))});
  M.panX = Number(M.panX || 0); M.panY = Number(M.panY || 0); M.previewOnly = false;

  function sourceFor(asset) {return (state.project?.assets || []).find(item => item.id === asset?.source_asset_id) || (state.project?.assets || [])[0] || asset;}
  function previewBackground(){const stage=byId('previewStage');if(stage)stage.dataset.previewBackground=M.background||'transparent';}
  function scaleLabel(){const node=byId('m2aZoomValue');if(node)node.textContent=`${Math.round(Number(M.zoom||1)*100)}%`;}
  function applyTransform(){const plane=document.querySelector('#previewStage .m2a-transform-wrap');if(plane)plane.style.transform=`translate(${M.panX}px, ${M.panY}px) scale(${M.zoom||1})`;scaleLabel();}
  function fitScale(){const stage=byId('previewStage'),asset=selectedAsset();if(!stage||!asset)return 1;const{width,height}=assetDimensions(asset),availableWidth=Math.max(100,stage.clientWidth-32),availableHeight=Math.max(100,stage.clientHeight-32);return clamp(Math.min(availableWidth/width,availableHeight/height),.02,8);}
  function setZoomActual(value){M.zoom=clamp(Number(value||1),.02,8);applyTransform();updateBrushCursorSize();}
  function fitPreviewActual(){M.panX=0;M.panY=0;setZoomActual(fitScale());}
  function oneToOne(){M.panX=0;M.panY=0;setZoomActual(1);}

  function activeCropIds(){return state.module==='extract'?{x:'extractX',y:'extractY',width:'extractWidth',height:'extractHeight'}:{x:'cropX',y:'cropY',width:'cropWidth',height:'cropHeight'};}
  function cropValue(){const ids=activeCropIds();return{x:clamp(Number(byId(ids.x)?.value||0),0,99),y:clamp(Number(byId(ids.y)?.value||0),0,99),width:clamp(Number(byId(ids.width)?.value||100),1,100),height:clamp(Number(byId(ids.height)?.value||100),1,100)};}
  function writeCrop(value){const ids=activeCropIds(),normalized={x:clamp(value.x,0,99),y:clamp(value.y,0,99),width:clamp(value.width,1,100),height:clamp(value.height,1,100)};normalized.width=Math.min(normalized.width,100-normalized.x);normalized.height=Math.min(normalized.height,100-normalized.y);Object.entries(ids).forEach(([key,id])=>{if(byId(id))byId(id).value=Number(normalized[key]).toFixed(2);});positionCropBox();}
  function positionCropBox(){const box=byId('m2aCropBox');if(!box)return;const value=cropValue();box.style.left=`${value.x}%`;box.style.top=`${value.y}%`;box.style.width=`${value.width}%`;box.style.height=`${value.height}%`;applyPreviewOnly();}
  function applyPreviewOnly(){const plane=document.querySelector('#previewStage .m2a-transform-wrap');if(!plane)return;const crop=cropValue();plane.style.clipPath=M.previewOnly?`inset(${crop.y}% ${100-crop.x-crop.width}% ${100-crop.y-crop.height}% ${crop.x}%)`:'none';document.querySelectorAll('.m2a-preview-note').forEach(note=>{note.textContent=M.previewOnly?'Preview на уменьшенной копии · новая версия не создана':'Preview отключён';});document.querySelectorAll('.m2a-preview-only button').forEach(button=>{button.textContent=M.previewOnly?'Показать весь файл':'Предпросмотр без сохранения';});}
  function createCropBox(plane){if(!['geometry','extract'].includes(state.module))return;const box=document.createElement('div');box.id='m2aCropBox';box.className='m2a-crop-box';['nw','ne','se','sw'].forEach(corner=>{const handle=document.createElement('span');handle.className='m2a-crop-handle';handle.dataset.corner=corner;box.append(handle);});plane.append(box);positionCropBox();let start=null;box.addEventListener('pointerdown',event=>{event.preventDefault();event.stopPropagation();const rect=plane.getBoundingClientRect();start={pointerX:event.clientX,pointerY:event.clientY,rect,value:cropValue(),corner:event.target.dataset.corner||'move'};box.setPointerCapture(event.pointerId);});box.addEventListener('pointermove',event=>{if(!start)return;const dx=(event.clientX-start.pointerX)/Math.max(1,start.rect.width)*100,dy=(event.clientY-start.pointerY)/Math.max(1,start.rect.height)*100,v={...start.value};if(start.corner==='move'){v.x+=dx;v.y+=dy;v.x=clamp(v.x,0,100-v.width);v.y=clamp(v.y,0,100-v.height);}else{if(start.corner.includes('n')){v.y+=dy;v.height-=dy;}if(start.corner.includes('s'))v.height+=dy;if(start.corner.includes('w')){v.x+=dx;v.width-=dx;}if(start.corner.includes('e'))v.width+=dx;}writeCrop(v);});const finish=event=>{if(start){start=null;if(box.hasPointerCapture(event.pointerId))box.releasePointerCapture(event.pointerId);}};box.addEventListener('pointerup',finish);box.addEventListener('pointercancel',finish);}

  function perspectivePrefix(){return state.module==='extract'?'ep':'p';}
  function perspectiveEnabled(){return state.module==='extract'?Boolean(byId('extractPerspectiveEnabled')?.checked):Boolean(byId('usePerspective')?.checked);}
  function perspectivePoints(){const prefix=perspectivePrefix();return['TL','TR','BR','BL'].map(name=>({name,x:clamp(Number(byId(`${prefix}${name}x`)?.value||0),0,100),y:clamp(Number(byId(`${prefix}${name}y`)?.value||0),0,100)}));}
  function applyPerspectivePreview(){const points=perspectivePoints(),polygon=`polygon(${points.map(point=>`${point.x}% ${point.y}%`).join(',')})`;document.querySelectorAll('#previewStage .m2a-layer').forEach(node=>{node.style.clipPath=perspectiveEnabled()?polygon:'none';});points.forEach(point=>{const handle=byId(`m2aPerspective${point.name}`);if(handle){handle.style.left=`${point.x}%`;handle.style.top=`${point.y}%`;}});}
  function createPerspectiveHandles(plane){if(!['geometry','extract'].includes(state.module)||!perspectiveEnabled())return;perspectivePoints().forEach(point=>{const handle=document.createElement('button');handle.type='button';handle.id=`m2aPerspective${point.name}`;handle.className='m2a-perspective-handle';handle.textContent=point.name;handle.title=`Точка ${point.name}`;plane.append(handle);handle.addEventListener('pointerdown',event=>{event.preventDefault();event.stopPropagation();handle.setPointerCapture(event.pointerId);});handle.addEventListener('pointermove',event=>{if(!handle.hasPointerCapture(event.pointerId))return;const rect=plane.getBoundingClientRect(),x=clamp((event.clientX-rect.left)/Math.max(1,rect.width)*100,0,100),y=clamp((event.clientY-rect.top)/Math.max(1,rect.height)*100,0,100),prefix=perspectivePrefix();byId(`${prefix}${point.name}x`).value=x.toFixed(2);byId(`${prefix}${point.name}y`).value=y.toFixed(2);applyPerspectivePreview();});const finish=event=>{if(handle.hasPointerCapture(event.pointerId))handle.releasePointerCapture(event.pointerId);};handle.addEventListener('pointerup',finish);handle.addEventListener('pointercancel',finish);});applyPerspectivePreview();}

  function maskCanvasDimensions(asset){const{width,height}=assetDimensions(asset),scale=Math.min(1,1200/Math.max(width,height));return{width:Math.max(1,Math.round(width*scale)),height:Math.max(1,Math.round(height*scale)),scale};}
  function replayMask(canvas){if(!canvas)return;const ctx=canvas.getContext('2d',{willReadFrequently:true});ctx.clearRect(0,0,canvas.width,canvas.height);const point=raw=>[raw[0]*canvas.width,raw[1]*canvas.height],asset=selectedAsset(),sourceBrush=typeof selectionBrushPixels==='function'?selectionBrushPixels(asset):20,brush=sourceBrush*(canvas.width/assetDimensions(asset).width);for(const edit of[...(state.selectionEdits||[]),...(state.selectionDraft?[state.selectionDraft]:[])]){if(edit.tool==='invert'){const data=ctx.getImageData(0,0,canvas.width,canvas.height);for(let i=0;i<data.data.length;i+=4){const a=255-data.data[i+3];data.data[i]=45;data.data[i+1]=155;data.data[i+2]=255;data.data[i+3]=a;}ctx.putImageData(data,0,0);continue;}const points=edit.points||[];if(!points.length)continue;const subtract=['subtract','erase'].includes(edit.tool);ctx.save();ctx.globalCompositeOperation=subtract?'destination-out':'source-over';ctx.strokeStyle='rgba(45,155,255,.95)';ctx.fillStyle='rgba(45,155,255,.42)';ctx.lineWidth=Math.max(1,brush);ctx.lineCap='round';ctx.lineJoin='round';if(edit.tool==='rectangle'&&points.length>=2){const[a,b]=points.map(point);ctx.fillRect(Math.min(a[0],b[0]),Math.min(a[1],b[1]),Math.abs(a[0]-b[0]),Math.abs(a[1]-b[1]));}else if(edit.tool==='lasso'&&points.length>=3){ctx.beginPath();ctx.moveTo(...point(points[0]));points.slice(1).forEach(raw=>ctx.lineTo(...point(raw)));ctx.closePath();ctx.fill();}else{ctx.beginPath();ctx.moveTo(...point(points[0]));points.slice(1).forEach(raw=>ctx.lineTo(...point(raw)));if(points.length===1){const p=point(points[0]);ctx.lineTo(p[0]+.01,p[1]+.01);}ctx.stroke();}ctx.restore();}}
  drawSelectionOverlay=function(){replayMask(document.querySelector('#previewStage canvas.m2a-selection-layer'));};
  function setupMaskCanvas(canvas,plane){const asset=selectedAsset(),dims=maskCanvasDimensions(asset);canvas.width=dims.width;canvas.height=dims.height;canvas.classList.toggle('editable',state.module==='selection');const cursor=document.createElement('span');cursor.id='m2aBrushCursor';cursor.className='m2a-brush-cursor';plane.append(cursor);const normalized=event=>{const rect=canvas.getBoundingClientRect();return[clamp((event.clientX-rect.left)/Math.max(1,rect.width),0,1),clamp((event.clientY-rect.top)/Math.max(1,rect.height),0,1)];},moveCursor=event=>{const rect=plane.getBoundingClientRect();cursor.style.display=state.module==='selection'?'block':'none';cursor.style.left=`${(event.clientX-rect.left)/Math.max(M.zoom||1,.001)}px`;cursor.style.top=`${(event.clientY-rect.top)/Math.max(M.zoom||1,.001)}px`;updateBrushCursorSize();};canvas.addEventListener('pointermove',moveCursor);canvas.addEventListener('pointerleave',()=>{cursor.style.display='none';});canvas.addEventListener('pointerdown',event=>{if(state.module!=='selection')return;event.stopPropagation();canvas.setPointerCapture(event.pointerId);state.selectionDraft={tool:state.selectionTool||'add',points:[normalized(event)]};replayMask(canvas);});canvas.addEventListener('pointermove',event=>{if(!state.selectionDraft)return;const p=normalized(event);if(state.selectionDraft.tool==='rectangle')state.selectionDraft.points=[state.selectionDraft.points[0],p];else state.selectionDraft.points.push(p);replayMask(canvas);});const finish=event=>{if(canvas.hasPointerCapture(event.pointerId))canvas.releasePointerCapture(event.pointerId);if(!state.selectionDraft)return;const draft=state.selectionDraft;state.selectionDraft=null;if(draft.tool==='lasso'&&draft.points.length<3)return;if(draft.tool==='rectangle'&&draft.points.length<2)return;state.selectionEdits.push(draft);replayMask(canvas);M.saveMask?.().catch(error=>toast(error.message,true));};canvas.addEventListener('pointerup',finish);canvas.addEventListener('pointercancel',finish);replayMask(canvas);}
  function updateBrushCursorSize(){const cursor=byId('m2aBrushCursor'),asset=selectedAsset();if(!cursor||!asset)return;const pixels=typeof selectionBrushPixels==='function'?selectionBrushPixels(asset):20;cursor.style.width=`${Math.max(2,pixels)}px`;cursor.style.height=`${Math.max(2,pixels)}px`;}
  function createImage(asset,className){const image=document.createElement('img');image.src=`${asset.preview_url}?sha=${encodeURIComponent(asset.sha256||asset.id)}`;image.alt=asset.original_name;image.className=`m2a-layer ${className}`;image.draggable=false;return image;}

  function renderCompletePreview(){const stage=byId('previewStage'),asset=selectedAsset();if(!stage)return;document.querySelectorAll('[data-preview-mode]').forEach(button=>button.classList.toggle('active',button.dataset.previewMode===(M.mode||'result')));stage.replaceChildren();stage.className=`preview-stage checkerboard m2a-${M.mode||'result'}`;previewBackground();if(!asset)return;M.loadMask?.();const{width,height}=assetDimensions(asset),surface=document.createElement('div'),plane=document.createElement('div'),source=sourceFor(asset),mode=M.mode||'result';surface.className='m2a-preview-surface';plane.className='m2a-transform-wrap';plane.style.width=`${width}px`;plane.style.height=`${height}px`;if(mode==='original')plane.append(createImage(source,'m2a-source-image'));else if(['split','overlay','difference'].includes(mode)){const sourceImage=createImage(source,'m2a-source-image'),resultImage=createImage(asset,'m2a-result-image');plane.append(sourceImage,resultImage);if(mode==='overlay')resultImage.style.opacity='.5';if(mode==='difference')resultImage.style.mixBlendMode='difference';if(mode==='split'){const slider=document.createElement('input');slider.type='range';slider.min='0';slider.max='100';slider.value='50';slider.className='m2a-split-slider';const update=()=>{resultImage.style.clipPath=`inset(0 0 0 ${slider.value}%)`;};slider.addEventListener('input',update);update();plane.append(slider);}}else plane.append(createImage(asset,'m2a-result-image'));if(['mask','result'].includes(mode)||state.module==='selection'){const canvas=document.createElement('canvas');canvas.className='m2a-selection-layer';plane.append(canvas);setupMaskCanvas(canvas,plane);if(mode==='mask')plane.querySelectorAll('img').forEach(node=>{node.style.opacity='.3';node.style.filter='grayscale(1)';});}createCropBox(plane);createPerspectiveHandles(plane);surface.append(plane);stage.append(surface);applyPreviewOnly();if(!M.zoomInitialized){M.zoomInitialized=true;requestAnimationFrame(fitPreviewActual);}else applyTransform();bindPan(stage);}
  function bindPan(stage){let start=null;stage.onpointerdown=event=>{if(event.target.closest('.m2a-crop-box,.m2a-perspective-handle,.m2a-selection-layer,.m2a-split-slider'))return;start={x:event.clientX,y:event.clientY,panX:M.panX,panY:M.panY};stage.setPointerCapture(event.pointerId);};stage.onpointermove=event=>{if(!start)return;M.panX=start.panX+event.clientX-start.x;M.panY=start.panY+event.clientY-start.y;applyTransform();};const finish=event=>{start=null;if(stage.hasPointerCapture(event.pointerId))stage.releasePointerCapture(event.pointerId);};stage.onpointerup=finish;stage.onpointercancel=finish;}
  function ensurePreviewOnlyButtons(){['geometry','extract'].forEach(module=>{const pane=document.querySelector(`[data-pane="${module}"]`);if(!pane||pane.querySelector('.m2a-preview-only'))return;const apply=module==='geometry'?byId('applyGeometry'):byId('applyExtractPrint'),box=document.createElement('div');box.className='m2a-preview-only';box.innerHTML=`<button class="secondary-button wide" data-preview-only="${module}" type="button">Предпросмотр без сохранения</button><p class="m2a-preview-note">Preview отключён</p>`;apply?.before(box);});document.querySelectorAll('.m2a-preview-only button').forEach(button=>button.addEventListener('click',()=>{M.previewOnly=!M.previewOnly;applyPreviewOnly();}));}
  function validateSizeRequest(width,height,ppi,linked){if(!Number.isFinite(ppi)||ppi<100||ppi>1000)throw new Error('PPI должен быть от 100 до 1000');if(width!==''&&(!Number.isFinite(Number(width))||Number(width)<=0||Number(width)>2000))throw new Error('Ширина должна быть от 0,1 до 2000 мм');if(height!==''&&(!Number.isFinite(Number(height))||Number(height)<=0||Number(height)>2000))throw new Error('Высота должна быть от 0,1 до 2000 мм');if(width===''&&height==='')return;const asset=selectedAsset();let w=Number(width),h=Number(height);const ratio=assetDimensions(asset).width/assetDimensions(asset).height;if(linked){if(!w&&h)w=h*ratio;if(!h&&w)h=w/ratio;}if(!w||!h)throw new Error('Укажите оба размера или включите связь пропорций');const pixels=Math.round(w/25.4*ppi)*Math.round(h/25.4*ppi);if(pixels>40000000)throw new Error('Запрошенный размер превышает безопасный лимит памяти');}
  function installGeometryGuard(){const button=byId('applyGeometry');if(!button||button.dataset.m2aGuard)return;button.dataset.m2aGuard='1';button.addEventListener('click',event=>{event.preventDefault();event.stopImmediatePropagation();try{validateSizeRequest(byId('widthMm')?.value||'',byId('heightMm')?.value||'',Number(byId('geometryPpi')?.value||300),M.linked!==false);const params=typeof geometryParams==='function'?geometryParams():{};if(byId('usePerspective')?.checked)params.perspective=pointValues('p');processSelected('geometry',params,'Размер и геометрия применены');}catch(error){toast(error.message,true);}},true);['applyEnhance','applyReconstruct'].forEach(id=>{const node=byId(id);if(!node||node.dataset.m2aGuard)return;node.dataset.m2aGuard='1';node.addEventListener('click',event=>{try{validateSizeRequest(byId('improveWidthMm')?.value||'',byId('improveHeightMm')?.value||'',Number(byId('improvePpi')?.value||300),M.linked!==false);}catch(error){event.preventDefault();event.stopImmediatePropagation();toast(error.message,true);}},true);});}

  ensurePreviewOnlyButtons();installGeometryGuard();document.querySelectorAll('[data-preview-mode]').forEach(button=>{button.onclick=()=>{M.mode=button.dataset.previewMode;renderCompletePreview();};});byId('m2aZoomOut').onclick=()=>setZoomActual((M.zoom||1)/1.25);byId('m2aZoomIn').onclick=()=>setZoomActual((M.zoom||1)*1.25);byId('m2aFit').onclick=fitPreviewActual;byId('m2aOneToOne').onclick=oneToOne;byId('m2aZoomValue').onclick=oneToOne;byId('m2aPreviewBackground')?.addEventListener('change',event=>{M.background=event.target.value;previewBackground();});['usePerspective','extractPerspectiveEnabled'].forEach(id=>byId(id)?.addEventListener('change',renderCompletePreview));['cropX','cropY','cropWidth','cropHeight','extractX','extractY','extractWidth','extractHeight'].forEach(id=>byId(id)?.addEventListener('input',positionCropBox));['pTLx','pTLy','pTRx','pTRy','pBRx','pBRy','pBLx','pBLy','epTLx','epTLy','epTRx','epTRy','epBRx','epBRy','epBLx','epBLy'].forEach(id=>byId(id)?.addEventListener('input',applyPerspectivePreview));byId('selectionBrushMm')?.addEventListener('input',updateBrushCursorSize);const priorRender=renderProject;renderProject=function(){priorRender();renderCompletePreview();};window.addEventListener('resize',()=>{if(selectedAsset())fitPreviewActual();});renderCompletePreview();
})();
