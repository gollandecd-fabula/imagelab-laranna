  async function diagnostics(){const root=$('#m2aDiagnostics');try{const [h,a]=await Promise.all([api('/api/health'),api('/api/ai/health')]);S.runtime=a;root.innerHTML=`<div><span>Host</span><strong>${escapeHtml(h.host_policy||'localhost_only')}</strong></div><div><span>Версия</span><strong>${escapeHtml(h.version||'—')}</strong></div><div><span>Runtime</span><strong>${escapeHtml(a.runtime||'—')}</strong></div>`;const list=$('#m2aModelList');list.innerHTML=(a.models||[]).map(m=>`<div class="m2a-model-row"><strong>${escapeHtml(m.model_id||m.id||'model')}</strong><span>${escapeHtml(m.version||'')}</span></div>`).join('')||'<span>Нет активных моделей</span>';}catch(e){root.textContent=e.message;}}
  function saveSettings(){storage.set('imagelab.defaultMode',$('#m2aDefaultMode').value);storage.set('imagelab.defaultPpi',$('#m2aDefaultPpi').value);storage.set('imagelab.previewBackground',$('#m2aDefaultPreview').value);toast('Настройки сохранены');}
  async function dtfQa(){const status=$('#m2aDtfStatus');try{const r=await api(`/api/projects/${encodeURIComponent(PROJECT_ID)}/qa?asset_id=${encodeURIComponent(state.selectedId||'')}`);status.className=`m2a-status ${r.overall_passed?'pass':'blocked'}`;status.innerHTML=`<strong>${r.overall_passed?'PASS':'BLOCKED'}</strong><span>${r.overall_passed?'Файл прошёл DTF preflight':'Исправьте ошибки QA'}</span>`;}catch(e){toast(e.message,true);}}

  const baseActivate=activateModule;
  activateModule=function(module){baseActivate(module);document.querySelector('.m2a-mobile-nav')?.setAttribute('data-value',module);const mobile=document.querySelector('.m2a-mobile-nav');if(mobile)mobile.value=module;if(module==='projects')loadProjects();if(module==='presets')renderPresets();if(module==='batch')renderBatch();if(module==='settings')diagnostics();};
  const baseRender=renderProject;
  renderProject=function(){baseRender();renderProjects();renderPresets();renderBatch();renderPreview();updateSizeViews();const a=selectedAsset();if($('#m2aCardLabAsset'))$('#m2aCardLabAsset').textContent=a?.original_name||'Файл не выбран';const link=$('#m2aCardLabLink');if(link){link.href=a?`/api/projects/${encodeURIComponent(PROJECT_ID)}/cardlab-package?asset_id=${encodeURIComponent(a.id)}`:'#';link.setAttribute('aria-disabled',String(!a