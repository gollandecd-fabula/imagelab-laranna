(() => {
  'use strict';

  const M = window.imagelabM2A || (window.imagelabM2A = {});
  const byId = id => document.getElementById(id);
  const esc = value => String(value ?? '').replace(/[&<>"']/g, ch => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));
  const currentProjectId = () => state.project?.id || PROJECT_ID;
  const workspace = () => state.project?.workspace || {};
  const now = () => new Date().toISOString();
  const wait = ms => new Promise(resolve => setTimeout(resolve, ms));

  function setSaveState(mode, text) {
    const node = byId('m2aSaveState');
    if (!node) return;
    node.dataset.state = mode;
    node.textContent = text;
  }

  async function workspacePut(section, value) {
    if (!state.project) throw new Error('Проект не открыт');
    setSaveState('busy', 'сохранение…');
    try {
      const response = await api(`/api/m2a/projects/${encodeURIComponent(currentProjectId())}/workspace/${encodeURIComponent(section)}`, {
        method: 'PUT', headers: {'Content-Type':'application/json'}, body: JSON.stringify({value}),
      });
      state.project = response.project;
      setSaveState('saved', 'сохранено');
      return response.project;
    } catch (error) {
      setSaveState('error', 'ошибка');
      throw error;
    }
  }
  M.workspacePut = workspacePut; M.currentProjectId = currentProjectId;

  function addSettingsControls() {
    const pane = document.querySelector('[data-pane="settings"]');
    if (!pane || byId('m2aDefaultFolder')) return;
    const save = byId('m2aSaveSettings');
    const extra = document.createElement('section'); extra.className = 'm2a-settings-extra';
    extra.innerHTML = `<strong class="field-group-title">Папки, model packs и приватность</strong><div class="m2a-settings-grid">
      <label class="wide">Папка по умолчанию<input id="m2aDefaultFolder" maxlength="512" placeholder="Например: D:\\ImageLab\\Projects"></label>
      <label>Профиль QA<select id="m2aQaPolicy"><option value="mandatory">Обязательный</option><option value="strict">Строгий</option></select></label>
      <label>Профиль экспорта<select id="m2aExportProfile"><option value="transparent_png">PNG с прозрачностью</option><option value="dtf_pending">DTF — M2B</option><option value="svg_pending">SVG — M2B</option></select></label>
      <label class="check-row"><input id="m2aPrivacyLocal" type="checkbox" checked> Локальная обработка по умолчанию</label>
      <label class="check-row"><input id="m2aCloudConsent" type="checkbox"> Разрешать запрос согласия на cloud fallback</label>
      <fieldset class="wide"><legend>Запрашиваемые model packs</legend><label class="check-row"><input type="checkbox" data-model-pack="background"> Background</label><label class="check-row"><input type="checkbox" data-model-pack="restore"> Restore</label><label class="check-row"><input type="checkbox" data-model-pack="vector"> Vector</label><label class="check-row"><input type="checkbox" data-model-pack="inpaint"> Inpaint</label><p class="hint">Установка и rollback пакетов относятся к M3. На M2A сохраняется только пользовательский выбор.</p></fieldset>
    </div>`;
    save?.before(extra);
    const diagnosticsButton = byId('m2aRefreshDiagnostics');
    if (diagnosticsButton && !byId('m2aDownloadDiagnostics')) {
      const actions = document.createElement('div'); actions.className = 'm2a-diagnostic-actions'; diagnosticsButton.before(actions); actions.append(diagnosticsButton);
      const download = document.createElement('a'); download.id = 'm2aDownloadDiagnostics'; download.className = 'secondary-button link-button'; download.href = '/api/m2a/diagnostics-report'; download.textContent = 'Скачать безопасный report'; actions.append(download);
    }
    const states = document.createElement('div'); states.className = 'm2a-state-sample'; states.setAttribute('aria-label', 'Примеры обязательных состояний'); states.innerHTML = '<span class="warning">WARNING</span><span class="error">ERROR</span><span class="blocked">BLOCKED</span>'; pane.append(states);
  }

  function settingsValue() {
    return {default_mode:byId('m2aDefaultMode')?.value||'professional',default_ppi:Number(byId('m2aDefaultPpi')?.value||300),preview_background:byId('m2aDefaultPreview')?.value||'transparent',default_folder:byId('m2aDefaultFolder')?.value.trim()||'',qa_policy:byId('m2aQaPolicy')?.value||'mandatory',export_profile:byId('m2aExportProfile')?.value||'transparent_png',privacy:{local_only:Boolean(byId('m2aPrivacyLocal')?.checked),cloud_consent_prompt:Boolean(byId('m2aCloudConsent')?.checked)},requested_model_packs:[...document.querySelectorAll('[data-model-pack]:checked')].map(node=>node.dataset.modelPack)};
  }
  function restoreSettings() {
    const value=workspace().settings||{};
    if(byId('m2aDefaultMode'))byId('m2aDefaultMode').value=value.default_mode||state.operationMode||'professional'; if(byId('m2aDefaultPpi'))byId('m2aDefaultPpi').value=value.default_ppi||300; if(byId('m2aDefaultPreview'))byId('m2aDefaultPreview').value=value.preview_background||M.background||'transparent'; if(byId('m2aDefaultFolder'))byId('m2aDefaultFolder').value=value.default_folder||''; if(byId('m2aQaPolicy'))byId('m2aQaPolicy').value=value.qa_policy||'mandatory'; if(byId('m2aExportProfile'))byId('m2aExportProfile').value=value.export_profile||'transparent_png'; if(byId('m2aPrivacyLocal'))byId('m2aPrivacyLocal').checked=value.privacy?.local_only!==false; if(byId('m2aCloudConsent'))byId('m2aCloudConsent').checked=Boolean(value.privacy?.cloud_consent_prompt); const packs=new Set(value.requested_model_packs||[]);document.querySelectorAll('[data-model-pack]').forEach(node=>{node.checked=packs.has(node.dataset.modelPack);});
  }
  async function saveSettingsSafe(){try{await workspacePut('settings',settingsValue());toast('Настройки проекта сохранены');}catch(error){toast(error.message,true);}}
  async function diagnosticsSafe(){const root=byId('m2aDiagnostics');if(!root)return;root.textContent='Проверка…';try{const data=await api('/api/m2a/diagnostics');root.innerHTML=[['Host',data.application?.host_policy],['CPU',`${data.system?.cpu_logical??'—'} logical`],['GPU',data.system?.gpu],['Runtime',`${data.runtime?.status||'—'} · ${(data.runtime?.providers||[]).join(', ')||'нет provider'}`],['Модели',String(data.runtime?.models?.length??0)],['Диск свободно',typeof fmtBytes==='function'?fmtBytes(data.disk?.free_bytes):String(data.disk?.free_bytes??'—')],['Приватность',data.privacy?.image_content_included===false&&data.privacy?.secrets_included===false?'без изображений и секретов':'BLOCKED']].map(([label,value])=>`<div><span>${esc(label)}</span><strong>${esc(value??'—')}</strong></div>`).join('');const list=byId('m2aModelList');if(list)list.innerHTML=(data.runtime?.models||[]).map(model=>`<div class="m2a-model-row"><strong>${esc(model.model_id||model.id||'model')}</strong><span>${esc(model.version||model.status||'')}</span></div>`).join('')||'<span>Нет активных моделей</span>';}catch(error){root.textContent=error.message;}}

  function sizeValue(){return{linked:M.linked!==false,leading:M.leading||'auto',resample:M.resample!==false,width_mm:byId('widthMm')?.value||'',height_mm:byId('heightMm')?.value||'',improve_width_mm:byId('improveWidthMm')?.value||'',improve_height_mm:byId('improveHeightMm')?.value||'',ppi:Number(byId('geometryPpi')?.value||300),improve_ppi:Number(byId('improvePpi')?.value||300),canvas:{top_mm:Number(byId('m2aCanvasTop')?.value||0),bottom_mm:Number(byId('m2aCanvasBottom')?.value||0),left_mm:Number(byId('m2aCanvasLeft')?.value||0),right_mm:Number(byId('m2aCanvasRight')?.value||0)}};}
  function restoreSize(){const value=workspace().size_controller;if(!value)return;M.linked=value.linked!==false;M.leading=value.leading||'auto';M.resample=value.resample!==false;const values={widthMm:value.width_mm,heightMm:value.height_mm,improveWidthMm:value.improve_width_mm||value.width_mm,improveHeightMm:value.improve_height_mm||value.height_mm,geometryPpi:value.ppi,improvePpi:value.improve_ppi||value.ppi,m2aCanvasTop:value.canvas?.top_mm,m2aCanvasBottom:value.canvas?.bottom_mm,m2aCanvasLeft:value.canvas?.left_mm,m2aCanvasRight:value.canvas?.right_mm};Object.entries(values).forEach(([id,val])=>{if(byId(id)&&val!==undefined&&val!==null)byId(id).value=val;});if(byId('m2aLeading'))byId('m2aLeading').value=M.leading;if(byId('m2aResample'))byId('m2aResample').checked=M.resample;document.querySelectorAll('.m2a-chain').forEach(node=>{node.dataset.linked=String(M.linked);node.setAttribute('aria-pressed',String(M.linked));});const legacy=byId('improvePreserveAspect');if(legacy){legacy.checked=M.linked;legacy.closest('label')?.classList.add('m2a-legacy-hidden');}if(typeof updateSizeViews==='function')updateSizeViews();}
  let sizeTimer;function scheduleSizeSave(){clearTimeout(sizeTimer);sizeTimer=setTimeout(()=>workspacePut('size_controller',sizeValue()).catch(error=>toast(error.message,true)),250);}

  function collectPresetParameters(module){const policy={engine_policy:byId('m2aPrivacyLocal')?.checked===false?'consent_required':'local_only',qa_policy:byId('m2aQaPolicy')?.value||'mandatory',export_profile:byId('m2aExportProfile')?.value||'transparent_png'};if(module==='geometry')return{...policy,size_controller:sizeValue()};if(module==='improve')return{...policy,width_mm:byId('improveWidthMm')?.value||'',height_mm:byId('improveHeightMm')?.value||'',ppi:Number(byId('improvePpi')?.value||300)};return policy;}
  async function savePresetSafe(){const name=byId('m2aPresetName')?.value.trim(),module=byId('m2aPresetModule')?.value;if(!name||!module)return toast('Введите название и модуль профиля',true);try{const response=await api(`/api/m2a/projects/${encodeURIComponent(currentProjectId())}/presets`,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({name,module,parameters:collectPresetParameters(module)})});state.project=response.project;renderProject();setSaveState('saved','сохранено');toast('Профиль сохранён без секретов');}catch(error){setSaveState('error','ошибка');toast(error.message,true);}}
  function applyPreset(preset){const p=preset?.parameters||{};if(p.engine_policy&&byId('m2aPrivacyLocal'))byId('m2aPrivacyLocal').checked=p.engine_policy==='local_only';if(p.qa_policy&&byId('m2aQaPolicy'))byId('m2aQaPolicy').value=p.qa_policy;if(p.export_profile&&byId('m2aExportProfile'))byId('m2aExportProfile').value=p.export_profile;if(p.size_controller){state.project.workspace.size_controller=p.size_controller;restoreSize();}if(preset.module==='improve'){if(byId('improveWidthMm'))byId('improveWidthMm').value=p.width_mm||'';if(byId('improveHeightMm'))byId('improveHeightMm').value=p.height_mm||'';if(byId('improvePpi'))byId('improvePpi').value=p.ppi||300;}activateModule(preset.module);toast('Профиль применён к интерфейсу');}
  function bindPresetRows(){const entries=Object.entries(workspace().presets||{});document.querySelectorAll('#m2aPresetList .m2a-preset-row').forEach((row,index)=>{const use=row.querySelector('[data-use]');if(use&&entries[index])use.onclick=()=>applyPreset(entries[index][1]);});refreshBatchPresetOptions();}

  const batch=M.batch={running:false,paused:false,cancelled:false,completed:[],startedAt:0};
  function ensureBatchControls(){const pane=document.querySelector('[data-pane="batch"]'),run=byId('m2aRunBatch');if(!pane||!run||byId('m2aBatchPause'))return;const preset=document.createElement('label');preset.innerHTML='Профиль<select id="m2aBatchPreset"><option value="">Без профиля</option></select>';run.before(preset);const controls=document.createElement('div');controls.className='m2a-batch-controls';run.before(controls);controls.append(run);const pause=document.createElement('button');pause.id='m2aBatchPause';pause.type='button';pause.className='secondary-button';pause.textContent='Пауза';pause.disabled=true;const cancel=document.createElement('button');cancel.id='m2aBatchCancel';cancel.type='button';cancel.className='secondary-button danger';cancel.textContent='Отменить после текущего';cancel.disabled=true;controls.append(pause,cancel);const job=byId('m2aBatchJob');if(job)job.insertAdjacentHTML('beforeend','<span id="m2aBatchStage">этап: ожидание</span><span id="m2aBatchEngine">engine: local</span><span id="m2aBatchElapsed">0 с</span>');const report=document.createElement('div');report.id='m2aBatchReport';report.className='m2a-batch-report';report.innerHTML='<span>Отчёт появится после запуска</span>';job?.after(report);pause.onclick=()=>{batch.paused=!batch.paused;pause.textContent=batch.paused?'Продолжить':'Пауза';byId('m2aBatchStage').textContent=batch.paused?'этап: пауза':'этап: обработка';};cancel.onclick=()=>{batch.cancelled=true;cancel.disabled=true;byId('m2aBatchStage').textContent='этап: отмена после текущего';};const select=byId('m2aBatchOperation');if(select)select.replaceChildren(new Option('Улучшение','enhance'),new Option('Восстановление','reconstruct'),new Option('Размер и холст','geometry'));}
  function refreshBatchPresetOptions(){const select=byId('m2aBatchPreset');if(!select)return;const selected=select.value;select.replaceChildren(new Option('Без профиля',''));Object.entries(workspace().presets||{}).forEach(([name,preset])=>select.append(new Option(`${name} · ${preset.module}`,name)));if([...select.options].some(option=>option.value===selected))select.value=selected;}
  function batchParameters(operation){const name=byId('m2aBatchPreset')?.value,preset=name?workspace().presets?.[name]:null;if(preset?.module==='geometry'&&preset.parameters?.size_controller){const s=preset.parameters.size_controller;return{width_mm:s.width_mm,height_mm:s.height_mm,ppi:s.ppi,preserve_aspect:s.linked,leading_side:s.leading,resample:s.resample,canvas:s.canvas,auto_repair:false};}if(operation==='geometry')return{...(typeof geometryParams==='function'?geometryParams():{}),auto_repair:false};return{auto_repair:false};}
  function renderBatchReport(){const root=byId('m2aBatchReport');if(!root)return;root.innerHTML=batch.completed.length?batch.completed.map(item=>`<div><span>${esc(item.name)}</span><strong data-status="${esc(item.status)}">${esc(item.status)}</strong></div>`).join(''):'<span>Нет завершённых элементов</span>';}
  async function runBatchSafe(){if(batch.running)return;const ids=[...document.querySelectorAll('#m2aBatchAssets input:checked')].map(node=>node.value);if(!ids.length)return toast('Выберите файлы',true);const operation=byId('m2aBatchOperation')?.value||'enhance',originalById=new Map((state.project?.assets||[]).map(asset=>[asset.id,asset]));batch.running=true;batch.paused=false;batch.cancelled=false;batch.completed=[];batch.startedAt=Date.now();byId('m2aBatchPause').disabled=false;byId('m2aBatchCancel').disabled=false;byId('m2aRunBatch').disabled=true;const progress=byId('m2aBatchJob')?.querySelector('progress'),label=byId('m2aBatchJob')?.querySelector('span'),timer=setInterval(()=>{if(byId('m2aBatchElapsed'))byId('m2aBatchElapsed').textContent=`${Math.floor((Date.now()-batch.startedAt)/1000)} с`;},250);try{for(let index=0;index<ids.length;index+=1){while(batch.paused&&!batch.cancelled)await wait(100);if(batch.cancelled)break;const sourceId=ids[index],source=originalById.get(sourceId);if(label)label.textContent=`${index+1}/${ids.length}`;if(byId('m2aBatchStage'))byId('m2aBatchStage').textContent=`этап: ${operation}`;if(progress)progress.value=Math.round(index/ids.length*100);try{const response=await api(`/api/projects/${encodeURIComponent(currentProjectId())}/process`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({asset_id:sourceId,operation,parameters:batchParameters(operation)})});state.project=response.project;state.selectedId=response.result.id;batch.completed.push({source_asset_id:sourceId,result_asset_id:response.result.id,name:source?.original_name||sourceId,status:'PASS'});}catch(error){batch.completed.push({source_asset_id:sourceId,name:source?.original_name||sourceId,status:'FAIL',detail:error.message});renderBatchReport();throw error;}renderProject();renderBatchReport();if(progress)progress.value=Math.round((index+1)/ids.length*100);}const status=batch.cancelled?'CANCELLED':'PASS';if(batch.cancelled)batch.completed.push({name:'Оставшаяся очередь',status:'CANCELLED'});const report={id:`batch-${Date.now().toString(36)}`,created_at:now(),operation,status,requested:ids.length,completed:batch.completed.filter(item=>item.status==='PASS').length,items:batch.completed},reports=[...(workspace().batch_reports||[]),report].slice(-50);await workspacePut('batch_reports',reports);if(label)label.textContent=status==='PASS'?'Готово':'Отменено';if(byId('m2aBatchStage'))byId('m2aBatchStage').textContent=`этап: ${status.toLowerCase()}`;toast(status==='PASS'?'Пакет завершён':'Пакет отменён; завершённые результаты сохранены',status!=='PASS');}catch(error){if(label)label.textContent='Ошибка';toast(error.message,true);}finally{clearInterval(timer);batch.running=false;batch.paused=false;byId('m2aBatchPause').disabled=true;byId('m2aBatchPause').textContent='Пауза';byId('m2aBatchCancel').disabled=true;byId('m2aRunBatch').disabled=false;renderBatchReport();}}

  function ensureMaskToolbar(){const pane=document.querySelector('[data-pane="selection"]'),apply=byId('applySelection');if(!pane||!apply||byId('m2aMaskToolbar'))return;const toolbar=document.createElement('div');toolbar.id='m2aMaskToolbar';toolbar.className='m2a-mask-toolbar';[['add','Add'],['subtract','Subtract'],['erase','Eraser'],['lasso','Lasso'],['rectangle','Rectangle'],['clear','Clear'],['invert','Invert']].forEach(([tool,label])=>{const button=document.createElement('button');button.type='button';button.className='secondary-button';button.dataset.maskTool=tool;button.textContent=label;toolbar.append(button);});apply.before(toolbar);toolbar.addEventListener('click',event=>{const button=event.target.closest('[data-mask-tool]');if(!button)return;const tool=button.dataset.maskTool;if(tool==='clear'){state.selectionEdits=[];state.selectionDraft=null;M.maskInverted=false;if(typeof drawSelectionOverlay==='function')drawSelectionOverlay();saveMask().catch(error=>toast(error.message,true));return;}if(tool==='invert'){state.selectionEdits.push({tool:'invert',points:[]});M.maskInverted=!M.maskInverted;if(typeof drawSelectionOverlay==='function')drawSelectionOverlay();saveMask().catch(error=>toast(error.message,true));return;}state.selectionTool=tool;document.querySelectorAll('[data-mask-tool]').forEach(node=>node.classList.toggle('active',node===button));});toolbar.querySelector('[data-mask-tool="add"]')?.classList.add('active');}
  function loadMask(){const asset=selectedAsset(),saved=asset?workspace().masks?.[asset.id]:null;state.selectionEdits=Array.isArray(saved?.edits)?structuredClone(saved.edits):[];state.selectionDraft=null;state.selectionAssetId=asset?.id||null;M.maskInverted=Boolean(saved?.inverted);return state.selectionEdits;}
  async function saveMask(){const asset=selectedAsset();if(!asset||!state.project)return;const masks={...(workspace().masks||{})};masks[asset.id]={edits:structuredClone(state.selectionEdits||[]),inverted:Boolean(M.maskInverted),updated_at:now()};await workspacePut('masks',masks);}
  M.loadMask=loadMask;M.saveMask=saveMask;

  function bindPersistence(){['widthMm','heightMm','improveWidthMm','improveHeightMm','geometryPpi','improvePpi','m2aLeading','m2aResample','m2aCanvasTop','m2aCanvasBottom','m2aCanvasLeft','m2aCanvasRight'].forEach(id=>byId(id)?.addEventListener('change',scheduleSizeSave));document.querySelectorAll('.m2a-chain').forEach(node=>node.addEventListener('click',scheduleSizeSave));byId('m2aSaveSettings').onclick=saveSettingsSafe;byId('m2aRefreshDiagnostics').onclick=diagnosticsSafe;byId('m2aSavePreset').onclick=savePresetSafe;byId('m2aRunBatch').onclick=runBatchSafe;}

  addSettingsControls();ensureBatchControls();ensureMaskToolbar();bindPersistence();restoreSettings();restoreSize();diagnosticsSafe();refreshBatchPresetOptions();const presetRoot=byId('m2aPresetList');if(presetRoot)new MutationObserver(bindPresetRows).observe(presetRoot,{childList:true,subtree:true});const previousRender=renderProject;renderProject=function(){previousRender();restoreSettings();restoreSize();refreshBatchPresetOptions();bindPresetRows();};
})();
