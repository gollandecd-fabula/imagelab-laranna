ut id="m2aCanvasTop" type="number" min="0" value="0"></label><label>Снизу<input id="m2aCanvasBottom" type="number" min="0" value="0"></label><label>Слева<input id="m2aCanvasLeft" type="number" min="0" value="0"></label><label>Справа<input id="m2aCanvasRight" type="number" min="0" value="0"></label></div><div id="m2aRequestedActual" class="m2a-requested">Запрошено / Получено: укажите размеры</div>';
    apply.before(wrap); $('#m2aLeading').value=S.leading; $('#m2aResample').checked=S.resample; $('#m2aLeading').onchange=e=>{S.leading=e.target.value;storage.set('imagelab.sizeLeading',S.leading);}; $('#m2aResample').onchange=e=>{S.resample=e.target.checked;storage.set('imagelab.resample',String(S.resample));updateSizeViews();};
    ['m2aCanvasTop','m2aCanvasBottom','m2aCanvasLeft','m2aCanvasRight','geometryPpi'].forEach(id=>$(`#${id}`).addEventListener('input',updateSizeViews));
  }
  function geometryParams() { return {width_mm:$('#widthMm').value,height_mm:$('#heightMm').value,ppi:number('#geometryPpi',300),preserve_aspect:S.linked,leading_side:S.leading,resample:S.resample,canvas:{top_mm:number('#m2aCanvasTop'),bottom_mm:number('#m2aCanvasBottom'),left_mm:number('#m2aCanvasLeft'),right_mm:number('#m2aCanvasRight')},rotate:number('#rotateAngle'),crop:{x:number('#cropX'),y:number('#cropY'),width:number('#cropWidth',100),height:number('#cropHeight',100)},ai_auto_crop:$('#geometryAiCrop').checked}; }
  function updateSizeViews() { const n=$('#m2aRequestedActual'); if(!n)return; const w=number('#widthMm'),h=number('#heightMm'),ppi=number('#geometryPpi',300); n.textContent=`Запрошено: ${w||'—'} × ${h||'—'} мм · ${ppi} PPI · ${S.resample?'Resample':'PPI only'} · ${S.linked?'пропорции связаны':'связь снята'}`; }

  function setZoom(v){S.zoom=Math.min(8,Math.max(.1,v)); const wrap=document.querySelector('.m2a-transform-wrap'); if(wrap)wrap.style.transform=`translate(${S.panX||0}px,${S.panY||0}px) scale(${S.zoom})`; $('#m2aZoomValue').textContent=`${Math.round(S.zoom*100)}%`;}
  function fitPreview(){S.panX=0;S.panY=0;S.fitZoom=1;setZoom(1);$('#m2aZoomValue').textContent='Fit';}
  function applyPreviewBackground(){const stage=$('#previewStage');stage.dataset.previewBackground=S.background;}
